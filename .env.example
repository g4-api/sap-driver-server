# Local settings for the SAP driver server and its tests. Copy this file to .env and edit it; .env is gitignored.
#
# Precedence: shell variables win over .env, which wins over the Environment section of appsettings.json.
# The build copies a repository-root .env next to appsettings.json; publishing never copies it.
# Switches take true or false; 1 and 0 also work.

# Run the SAP GUI simulator end-to-end tests (starts the 32-bit simulator; opens windows on the desktop).
G4_SAP_SIMULATOR=false

# Simulator executable; empty uses the solution's build output.
G4_SAP_SIMULATOR_PATH=

# Published driver executable for the published-driver test; empty uses artifacts\sap-driver-server.
G4_SAP_DRIVER_PATH=

# Run the live SAP GUI tests (read-only; attaches to the SAP GUI running on this machine).
G4_SAP_INTEGRATION=false

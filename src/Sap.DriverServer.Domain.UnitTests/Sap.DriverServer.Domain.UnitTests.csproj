<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Sap.DriverServer\Sap.DriverServer.csproj" />
		<ProjectReference Include="..\Sap.DriverServer.Domain\Sap.DriverServer.Domain.csproj" />
		<ProjectReference Include="..\Sap.DriverServer.Inspector\Sap.DriverServer.Inspector.csproj" />
		<ProjectReference Include="..\Sap.DriverServer.Scripting\Sap.DriverServer.Scripting.csproj" />
		<ProjectReference Include="..\Sap.DriverServer.Settings\Sap.DriverServer.Settings.csproj" />

		<!-- Builds the 32-bit SAP GUI simulator for the opt-in end-to-end tests, which start it as a separate process. -->
		<ProjectReference Include="..\Sap.DriverServer.Simulator\Sap.DriverServer.Simulator.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>

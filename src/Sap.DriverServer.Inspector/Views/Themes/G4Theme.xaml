<!--
    G4 theme for the SAP GUI Inspector, "calm" variant.

    Keeps the G4 Gateway identity (g4-litellm, src/styles/theme.parameters.css): near-black surfaces, the electric blue
    accent, and IBM Plex type. For long inspection sessions it lowers glare: text is soft white instead of pure white,
    surfaces are separated by shade instead of borders, borders remain only on inputs and dividers, and the accent marks
    only the main action, focus, selection, and the active tab. Type is 14px with 32px controls on an 8px spacing grid.
    Every template reads only the tokens below.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Sap.DriverServer.Inspector.Views">

    <!-- ============================================================== Tokens: colors -->
    <!-- Surfaces: window, panels, controls, hover. Near-black, slightly lifted from pure black to reduce halation. -->
    <Color x:Key="G4BackgroundPrimaryColor">#FF0F0F11</Color>
    <Color x:Key="G4BackgroundSecondaryColor">#FF151518</Color>
    <Color x:Key="G4BackgroundTertiaryColor">#FF1C1C20</Color>
    <Color x:Key="G4BackgroundHoverColor">#FF232328</Color>
    <Color x:Key="G4BorderPrimaryColor">#FF26262B</Color>
    <Color x:Key="G4BorderSecondaryColor">#FF34343A</Color>
    <!-- Text: soft white (about 14:1 on the window), secondary (about 7:1, also used for hints), tertiary for disabled only. -->
    <Color x:Key="G4TextPrimaryColor">#FFE4E4E7</Color>
    <Color x:Key="G4TextSecondaryColor">#FFA1A1AA</Color>
    <Color x:Key="G4TextTertiaryColor">#FF71717A</Color>
    <Color x:Key="G4TextInverseColor">#FF0A0A0B</Color>
    <!-- Accent: the G4 electric blue, used selectively. -->
    <Color x:Key="G4AccentColor">#FF00D4FF</Color>
    <Color x:Key="G4AccentHoverColor">#FF00E5FF</Color>
    <Color x:Key="G4AccentActiveColor">#FF00B8E0</Color>
    <Color x:Key="G4AccentSubtleColor">#2400D4FF</Color>
    <Color x:Key="G4BrandEndColor">#FF0099CC</Color>
    <Color x:Key="G4SuccessColor">#FF22C55E</Color>
    <Color x:Key="G4WarningColor">#FFFACC15</Color>
    <Color x:Key="G4ErrorColor">#FFEF4444</Color>

    <!-- ============================================================== Tokens: brushes -->
    <SolidColorBrush x:Key="G4BackgroundPrimaryBrush" Color="{StaticResource G4BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="G4BackgroundSecondaryBrush" Color="{StaticResource G4BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="G4BackgroundTertiaryBrush" Color="{StaticResource G4BackgroundTertiaryColor}" />
    <SolidColorBrush x:Key="G4BackgroundHoverBrush" Color="{StaticResource G4BackgroundHoverColor}" />
    <SolidColorBrush x:Key="G4BorderPrimaryBrush" Color="{StaticResource G4BorderPrimaryColor}" />
    <SolidColorBrush x:Key="G4BorderSecondaryBrush" Color="{StaticResource G4BorderSecondaryColor}" />
    <SolidColorBrush x:Key="G4TextPrimaryBrush" Color="{StaticResource G4TextPrimaryColor}" />
    <SolidColorBrush x:Key="G4TextSecondaryBrush" Color="{StaticResource G4TextSecondaryColor}" />
    <SolidColorBrush x:Key="G4TextTertiaryBrush" Color="{StaticResource G4TextTertiaryColor}" />
    <SolidColorBrush x:Key="G4TextInverseBrush" Color="{StaticResource G4TextInverseColor}" />
    <SolidColorBrush x:Key="G4AccentBrush" Color="{StaticResource G4AccentColor}" />
    <SolidColorBrush x:Key="G4AccentHoverBrush" Color="{StaticResource G4AccentHoverColor}" />
    <SolidColorBrush x:Key="G4AccentActiveBrush" Color="{StaticResource G4AccentActiveColor}" />
    <SolidColorBrush x:Key="G4AccentSubtleBrush" Color="{StaticResource G4AccentSubtleColor}" />
    <SolidColorBrush x:Key="G4SuccessBrush" Color="{StaticResource G4SuccessColor}" />
    <SolidColorBrush x:Key="G4WarningBrush" Color="{StaticResource G4WarningColor}" />
    <SolidColorBrush x:Key="G4ErrorBrush" Color="{StaticResource G4ErrorColor}" />

    <!-- The brand mark gradient: electric blue to deep cyan at 135 degrees. -->
    <LinearGradientBrush x:Key="G4BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource G4AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource G4BrandEndColor}" />
    </LinearGradientBrush>

    <!-- System colors used by stock chrome this theme does not template (scroll viewer corner, inactive selection). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource G4BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource G4TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource G4TextTertiaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource G4AccentSubtleColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource G4AccentColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource G4AccentSubtleColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource G4AccentColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource G4BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource G4TextPrimaryColor}" />

    <!-- ============================================================== Tokens: type, icons, and shape -->
    <!-- Plex has no symbols such as arrows; Segoe UI Symbol supplies them. -->
    <FontFamily x:Key="G4SansFont">pack://application:,,,/Sap.DriverServer.Inspector;component/Fonts/#IBM Plex Sans, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="G4MonoFont">pack://application:,,,/Sap.DriverServer.Inspector;component/Fonts/#IBM Plex Mono</FontFamily>
    <!-- Display face for names and titles only, as in Z4 Golem; Plex Sans covers any missing glyph. -->
    <FontFamily x:Key="G4DisplayFont">pack://application:,,,/Sap.DriverServer.Inspector;component/Fonts/#Chakra Petch, pack://application:,,,/Sap.DriverServer.Inspector;component/Fonts/#IBM Plex Sans</FontFamily>
    <!-- Windows 11 icon font, with the Windows 10 icon font as fallback; both ship with Windows. -->
    <FontFamily x:Key="G4IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Square corners everywhere; the tokens stay so every template keeps reading its shape from one place. -->
    <CornerRadius x:Key="G4ControlRadius">0</CornerRadius>
    <CornerRadius x:Key="G4PanelRadius">0</CornerRadius>
    <CornerRadius x:Key="G4OptionRadius">0</CornerRadius>

    <!-- Chevrons used by the combo box and the tree expander. -->
    <Geometry x:Key="G4ChevronDownGeometry">M 0 0 L 4 4 L 8 0</Geometry>
    <Geometry x:Key="G4ChevronRightGeometry">M 0 0 L 4 4 L 0 8</Geometry>

    <!-- ============================================================== Window -->
    <!-- Applied explicitly by each window, because implicit styles skip Window subclasses. -->
    <Style x:Key="G4WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource G4BackgroundPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource G4SansFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource G4TextPrimaryBrush}" />
        <!-- Ideal keeps the designed letter shapes, like the browser does for Golem; Display would snap them to pixels. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Keyboard focus: a 2px electric blue ring around the control, like the web focus-visible ring. -->
    <Style x:Key="G4FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True" Stroke="{StaticResource G4AccentBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== Text styles -->
    <!-- Title of the selected element in the details pane. -->
    <Style x:Key="G4TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource G4DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Heading of a group inside a panel or tab. -->
    <Style x:Key="G4SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource G4DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource G4TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Label of an input or toggle. -->
    <Style x:Key="G4LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource G4TextPrimaryBrush}" />
    </Style>

    <!-- One-line explanation under a label; secondary text keeps it readable at 12px. -->
    <Style x:Key="G4HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource G4TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="G4MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource G4TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- An icon glyph from the Windows icon font. -->
    <Style x:Key="G4Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource G4IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SVG icons: path data copied from Assets/Icons/*.svg, all drawn on a 640 x 640 view box.
         F1 keeps the SVG nonzero fill rule. Change the .svg file and its geometry here together. -->

<UserControl x:Class="Sap.DriverServer.Simulator.Views.GridScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation">
    <!-- An ALV-like grid view shell; each column's SortMemberPath holds its SAP column name. -->
    <Border BorderBrush="#B8C2CC" BorderThickness="1" sim:ScriptingTree.Id="cntlGRID1">
        <Border sim:ScriptingTree.Id="shellcont">
            <DataGrid x:Name="FlightGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="OnFlightGridDoubleClick"
                      sim:ScriptingTree.Id="shell">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="90" Binding="{Binding Airline}" Header="Airline" SortMemberPath="CARRID" />
                    <DataGridTextColumn Width="100" Binding="{Binding FlightNumber}" Header="Flight No." SortMemberPath="CONNID" />
                    <DataGridTextColumn Width="110" Binding="{Binding FlightDate}" Header="Date" SortMemberPath="FLDATE" />
                    <DataGridTextColumn Width="100" Binding="{Binding Price}" Header="Price" SortMemberPath="PRICE" />
                    <DataGridTextColumn Width="90" Binding="{Binding Currency}" Header="Currency" SortMemberPath="CURRENCY" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Border>
</UserControl>

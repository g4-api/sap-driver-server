<views:FrameWindow x:Class="Sap.DriverServer.Simulator.Views.MainFrameWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation"
                   xmlns:views="clr-namespace:Sap.DriverServer.Simulator.Views"
                   Width="900"
                   Height="620"
                   MinWidth="640"
                   MinHeight="420"
                   PreviewKeyDown="OnPreviewKeyDown">
    <!-- The root grid is the scripting geometry of wnd[0]; the canvas above it holds Visualize frames. -->
    <Grid x:Name="RootGrid" Background="#F2F4F7">
        <!-- The rows follow SAP GUI's order: menu bar, system toolbar, title bar, application toolbar, user area, status bar. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Menu Grid.Row="0" sim:ScriptingTree.Id="mbar">
                <MenuItem sim:ScriptingTree.Id="menu[0]" Header="_Simulator">
                    <MenuItem sim:ScriptingTree.Id="menu[0]" Header="SAP Easy Access" Click="OnEasyAccessMenuClick" />
                    <MenuItem sim:ScriptingTree.Id="menu[1]" Header="Log off" Click="OnLogOffMenuClick" />
                </MenuItem>
            </Menu>

            <StackPanel Grid.Row="1" Margin="6,4" Orientation="Horizontal" sim:ScriptingTree.Id="tbar[0]">
                <Button Margin="0,0,4,0" Padding="10,2" Content="Enter" Tag="0" ToolTip="Enter (Enter)" Click="OnToolbarButtonClick" sim:ScriptingTree.Id="btn[0]" />
                <TextBox x:Name="CommandField" Width="180" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Command field" sim:ScriptingTree.Id="okcd" />
                <Button Margin="0,0,4,0" Padding="10,2" Content="Save" Tag="11" ToolTip="Save (Ctrl+S)" Click="OnToolbarButtonClick" sim:ScriptingTree.Id="btn[11]" />
                <Button Margin="0,0,4,0" Padding="10,2" Content="Back" Tag="3" ToolTip="Back (F3)" Click="OnToolbarButtonClick" sim:ScriptingTree.Id="btn[3]" />
                <Button Margin="0,0,4,0" Padding="10,2" Content="Exit" Tag="15" ToolTip="Exit (Shift+F3)" Click="OnToolbarButtonClick" sim:ScriptingTree.Id="btn[15]" />
                <Button Margin="0,0,4,0" Padding="10,2" Content="Cancel" Tag="12" ToolTip="Cancel (F12)" Click="OnToolbarButtonClick" sim:ScriptingTree.Id="btn[12]" />
            </StackPanel>

            <Border Grid.Row="2" Padding="12,6" Background="#DDE3EA" sim:ScriptingTree.Id="titl">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            </Border>

            <StackPanel Grid.Row="3" MinHeight="6" Orientation="Horizontal" sim:ScriptingTree.Id="tbar[1]" />

            <ContentControl x:Name="UserArea" Grid.Row="4" Margin="12" Focusable="False" sim:ScriptingTree.Id="usr" />

            <Border Grid.Row="5" Padding="12,4" Background="#E4E8EE" sim:ScriptingTree.Id="sbar">
                <TextBlock x:Name="StatusText" MinHeight="18" />
            </Border>
        </Grid>

        <Canvas x:Name="Highlights" IsHitTestVisible="False" />
    </Grid>
</views:FrameWindow>

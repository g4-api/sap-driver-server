<UserControl x:Class="Sap.DriverServer.Simulator.Views.RowDetailPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation">
    <!-- The detail popup of an ALV row shows the row's values in output fields. -->
    <Grid Margin="16" sim:ScriptingTree.Id="usr">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Airline" sim:ScriptingTree.Id="lblDETAIL-CARRID" />
        <TextBox x:Name="AirlineField" Grid.Row="0" Grid.Column="1" Margin="0,2" Background="#ECEFF3" IsReadOnly="True" sim:ScriptingTree.Id="txtDETAIL-CARRID" />
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Flight number" sim:ScriptingTree.Id="lblDETAIL-CONNID" />
        <TextBox x:Name="FlightNumberField" Grid.Row="1" Grid.Column="1" Margin="0,2" Background="#ECEFF3" IsReadOnly="True" sim:ScriptingTree.Id="txtDETAIL-CONNID" />
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Date" sim:ScriptingTree.Id="lblDETAIL-FLDATE" />
        <TextBox x:Name="DateField" Grid.Row="2" Grid.Column="1" Margin="0,2" Background="#ECEFF3" IsReadOnly="True" sim:ScriptingTree.Id="txtDETAIL-FLDATE" />
        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Price" sim:ScriptingTree.Id="lblDETAIL-PRICE" />
        <TextBox x:Name="PriceField" Grid.Row="3" Grid.Column="1" Margin="0,2" Background="#ECEFF3" IsReadOnly="True" TextAlignment="Right" sim:ScriptingTree.Id="txtDETAIL-PRICE" />
    </Grid>
</UserControl>

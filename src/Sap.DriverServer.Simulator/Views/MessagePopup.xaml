<UserControl x:Class="Sap.DriverServer.Simulator.Views.MessagePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation">
    <!-- A message dialog box shows the message text in output fields MESSTXT1 and answers through tbar[0]/btn[0]. -->
    <StackPanel Margin="16" Orientation="Horizontal" sim:ScriptingTree.Id="usr">
        <TextBlock x:Name="TypeMark" Width="28" FontSize="20" FontWeight="Bold" />
        <TextBox x:Name="MessageText" Width="360" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" sim:ScriptingTree.Id="txtMESSTXT1" />
    </StackPanel>
</UserControl>

<UserControl x:Class="Sap.DriverServer.Simulator.Views.ShellsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation"
             xmlns:views="clr-namespace:Sap.DriverServer.Simulator.Views">
    <!-- Shell controls (toolbar, splitter with text edit and picture), a box whose fields are siblings, and a scroll container. -->
    <StackPanel>
        <Border BorderBrush="#B8C2CC" BorderThickness="1" sim:ScriptingTree.Id="cntlTOOLBAR">
            <Border Padding="4" sim:ScriptingTree.Id="shellcont">
                <views:ShellToolbar x:Name="ToolbarShell" sim:ScriptingTree.Id="shell" />
            </Border>
        </Border>

        <Border Height="150" Margin="0,8,0,0" BorderBrush="#B8C2CC" BorderThickness="1" sim:ScriptingTree.Id="cntlSPLITTER">
            <Border x:Name="SplitterArea" sim:ScriptingTree.Id="shellcont" />
        </Border>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The box only draws the frame; the fields on top of it are its siblings, as in SAP's dynpro boxes. -->
            <GroupBox Grid.Column="0" Height="120" VerticalAlignment="Top" Header="Address" sim:ScriptingTree.Id="boxZSIM_SHELLS-ADDRESS" />
            <StackPanel Grid.Column="0" Margin="12,28,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="90" VerticalAlignment="Center" Text="Street" sim:ScriptingTree.Id="lblZSIM_SHELLS-STREET" />
                    <TextBox Width="200" Text="1 Simulator Way" sim:ScriptingTree.Id="txtZSIM_SHELLS-STREET" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Width="90" VerticalAlignment="Center" Text="City" sim:ScriptingTree.Id="lblZSIM_SHELLS-CITY" />
                    <TextBox Width="200" Text="Sim City" sim:ScriptingTree.Id="txtZSIM_SHELLS-CITY" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="ScrollArea" Grid.Column="1" Height="120" Margin="8,0,0,0" BorderBrush="#B8C2CC" BorderThickness="1" VerticalScrollBarVisibility="Auto" sim:ScriptingTree.Id="ssubSCROLL_AREA:SAPMZSIM_SHELLS:0200">
                <StackPanel x:Name="ScrollLines" Margin="6" />
            </ScrollViewer>
        </Grid>
    </StackPanel>
</UserControl>

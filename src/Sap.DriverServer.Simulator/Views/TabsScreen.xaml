<UserControl x:Class="Sap.DriverServer.Simulator.Views.TabsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sim="clr-namespace:Sap.DriverServer.Simulator.Simulation">
    <!--
        Tab strips whose pages fill one subscreen area with different subscreens, so a field's identifier changes with
        the selected tab; the third tab nests a second tab strip. Only the selected tab's content is scriptable.
    -->
    <StackPanel HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="140" VerticalAlignment="Center" Text="Order" sim:ScriptingTree.Id="lblZSIM_TABS-ORDER" />
            <TextBox Width="160" Background="#ECEFF3" IsReadOnly="True" Text="4500000815" sim:ScriptingTree.Id="txtZSIM_TABS-ORDER" />
        </StackPanel>

        <TabControl Width="560" Height="260" Margin="0,12,0,0" HorizontalAlignment="Left" sim:ScriptingTree.Id="tabsTS_MAIN">
            <TabItem Header="General" sim:ScriptingTree.Id="tabpT\01">
                <StackPanel Margin="8" sim:ScriptingTree.Id="ssubSUB_MAIN:SAPMZSIM_TABS:0110">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Customer" sim:ScriptingTree.Id="lblZSIM_TABS-KUNNR" />
                        <TextBox Width="160" Text="SIM-CUST-01" sim:ScriptingTree.Id="ctxtZSIM_TABS-KUNNR" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Note" sim:ScriptingTree.Id="lblZSIM_TABS-NOTE" />
                        <TextBox Width="300" sim:ScriptingTree.Id="txtZSIM_TABS-NOTE" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Details" sim:ScriptingTree.Id="tabpT\02">
                <StackPanel Margin="8" sim:ScriptingTree.Id="ssubSUB_MAIN:SAPMZSIM_TABS:0120">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Weight" sim:ScriptingTree.Id="lblZSIM_TABS-BRGEW" />
                        <TextBox Width="120" Text="12.500" TextAlignment="Right" sim:DynproField.IsNumerical="True" sim:ScriptingTree.Id="txtZSIM_TABS-BRGEW" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Width="140" VerticalAlignment="Center" Text="Note" sim:ScriptingTree.Id="lblZSIM_TABS-NOTE" />
                        <TextBox Width="300" sim:ScriptingTree.Id="txtZSIM_TABS-NOTE" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Nested" sim:ScriptingTree.Id="tabpT\03">
                <StackPanel Margin="8" sim:ScriptingTree.Id="ssubSUB_MAIN:SAPMZSIM_TABS:0130">
                    <TabControl Width="500" Height="150" HorizontalAlignment="Left" sim:ScriptingTree.Id="tabsTS_INNER">
                        <TabItem Header="Inner A" sim:ScriptingTree.Id="tabpI\01">
                            <StackPanel Margin="8" Orientation="Horizontal" sim:ScriptingTree.Id="ssubSUB_INNER:SAPMZSIM_TABS:0131">
                                <TextBlock Width="132" VerticalAlignment="Center" Text="Inner text" sim:ScriptingTree.Id="lblZSIM_TABS-INNER" />
                                <TextBox Width="200" Text="Inner A value" sim:ScriptingTree.Id="txtZSIM_TABS-INNER" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Inner B" sim:ScriptingTree.Id="tabpI\02">
                            <StackPanel Margin="8" sim:ScriptingTree.Id="ssubSUB_INNER:SAPMZSIM_TABS:0132">
                                <CheckBox Content="Deep option" sim:ScriptingTree.Id="chkZSIM_TABS-DEEP" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Margin="0,8,0,0" Foreground="#6B7785" Text="The Note field has a different identifier on each tab, because each tab shows its own subscreen." sim:ScriptingTree.Id="lblZSIM_TABS-HINT" />
    </StackPanel>
</UserControl>
